rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    // Ảnh sản phẩm (medicines)
    // Path: /medicines/{medicineId}/image.{ext}
    match /medicines/{medicineId}/{fileName} {
      allow read: if request.auth != null;
      allow write: if request.auth != null &&
        firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.role == 'warehouse_manager' &&
        request.resource.size < 5 * 1024 * 1024 && // max 5MB
        request.resource.contentType.matches('image/.*');
      allow delete: if request.auth != null &&
        firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.role == 'warehouse_manager';
    }

  }
}
